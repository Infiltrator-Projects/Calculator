#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later

%:
	dh $@ --buildsystem=cmake --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_test:
	ctest --test-dir build --output-on-failure

# Linux Mint Software Manager resolves APT icons from local package-name aliases.
override_dh_install:
	dh_install
	install -D -m 0644 debian/infiltrator-calc.svg \
		"$(CURDIR)/debian/infiltrator-calculator/usr/share/app-install/icons/infiltrator-calculator.svg"

#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later

%:
	dh $@ --buildsystem=cmake --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_test:
	ctest --test-dir build --output-on-failure

# Linux Mint Software Manager resolves APT icons from local package-name aliases.
override_dh_install:
	dh_install
	# MB Corpo is a persistent native machine resource, not Calculator payload.
	rm -rf "$(CURDIR)/debian/calculator/usr/share/fonts/truetype/calculator"
	install -D -m 0755 src/infiltratr-common/cmake/InfiltratrEnsureExtendedFonts.sh \
		"$(CURDIR)/debian/calculator/System/Commands/calculator-ensure-fonts"
	install -D -m 0644 debian/calculator.svg \
		"$(CURDIR)/debian/calculator/usr/share/app-install/icons/calculator.svg"
	if [ -f .calculator-native-build-info ]; then \
		install -D -m 0644 .calculator-native-build-info \
			"$(CURDIR)/debian/calculator/System/Resources/Documentation/Calculator/BUILD-INFO"; \
	fi
